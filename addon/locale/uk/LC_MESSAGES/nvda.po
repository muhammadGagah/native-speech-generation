#. Translators: Error shown when this add-on has no trusted checksum for a dependency archive.
#: addon\globalPlugins\NativeSpeechGeneration\lib_updater.py:117
#, python-brace-format
msgid "No approved checksum is bundled for {assetName}."
msgstr "Для {assetName} немає затвердженої контрольної суми."

#. Translators: Error shown when the GitHub release metadata cannot identify the release version.
#: addon\globalPlugins\NativeSpeechGeneration\lib_updater.py:137
msgid "The latest library release does not include a version tag."
msgstr "Останній випуск бібліотеки не містить тегу версії."

#: addon\globalPlugins\NativeSpeechGeneration\lib_updater.py:172
#, python-brace-format
msgid ""
"Failed to download or install required libraries. The add-on might not work "
"correctly.\n"
"\n"
"Error: {error}"
msgstr ""
"Не вдалося завантажити або встановити необхідні бібліотеки. Додаток може не "
"працювати належним чином.\n"
"\n"
"Помилка: {error}"

#. Translators: Title of a dependency installation error dialog.
#. Translators: Title of an error dialog in Talk With AI.
#. Translators: Status shown when Talk With AI enters an error state.
#. Translators: Title of an API key configuration error dialog.
#: addon\globalPlugins\NativeSpeechGeneration\lib_updater.py:174
#: addon\globalPlugins\NativeSpeechGeneration\lib_updater.py:223
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:292
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:294
#: addon\globalPlugins\NativeSpeechGeneration\__init__.py:134
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:438
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:458
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:492
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:532
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:545
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:571
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:664
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:751
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:775
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:821
#: addon\globalPlugins\NativeSpeechGeneration\interface\settings.py:140
msgid "Error"
msgstr "Помилка"

#. Translators: Title of a progress dialog shown while installing add-on dependencies.
#: addon\globalPlugins\NativeSpeechGeneration\lib_updater.py:189
msgid "Installing Dependencies"
msgstr "Встановлення залежностей"

#. Translators: Initial progress message while dependency installation is being prepared.
#: addon\globalPlugins\NativeSpeechGeneration\lib_updater.py:191
msgid "Checking for required libraries..."
msgstr "Перевірка необхідних бібліотек..."

#. Translators: Progress message shown when dependency installation has completed.
#: addon\globalPlugins\NativeSpeechGeneration\lib_updater.py:200
msgid "Installation complete!"
msgstr "Встановлення завершено!"

#. Translators: Message shown after dependencies are installed and NVDA must restart.
#: addon\globalPlugins\NativeSpeechGeneration\lib_updater.py:212
msgid ""
"The Native Speech Generation libraries have been successfully installed/"
"updated.\n"
"\n"
"Please restart NVDA for the changes to take effect."
msgstr ""
"Бібліотеки Генерації природного мовлення успішно встановлені/оновлені.\n"
"\n"
"Будь ласка, перезапустіть NVDA, щоб зміни набули чинності."

#. Translators: Title of the dialog shown after dependency installation completes.
#: addon\globalPlugins\NativeSpeechGeneration\lib_updater.py:215
msgid "Installation Complete"
msgstr "Встановлення завершено"

#. Translators: Error shown when dependency installation fails.
#: addon\globalPlugins\NativeSpeechGeneration\lib_updater.py:221
msgid "Library installation failed. Please check the log."
msgstr "Помилка встановлення бібліотеки. Будь ласка, перевірте журнал."

#. Translators: Confirmation before reinstalling or updating external Python dependencies from GitHub.
#: addon\globalPlugins\NativeSpeechGeneration\lib_updater.py:234
msgid ""
"This will download the latest verified libraries for your NVDA version and "
"require an NVDA restart. Continue?"
msgstr ""
"Це призведе до завантаження найновіших перевірених бібліотек для вашої "
"версії NVDA та потребуватиме перезапуску NVDA. Продовжити?"

#. Translators: Title of the dialog confirming a dependency library reinstall.
#: addon\globalPlugins\NativeSpeechGeneration\lib_updater.py:237
msgid "Confirm Library Update"
msgstr "Підтвердити оновлення бібліотеки"

#. Translators: Confirmation shown when required libraries are missing.
#: addon\globalPlugins\NativeSpeechGeneration\lib_updater.py:241
msgid ""
"Required libraries for Native Speech Generation are missing. Click OK to "
"download the latest verified package for your NVDA version."
msgstr ""
"Відсутні необхідні бібліотеки для генерації природного мовлення. Натисніть "
"OK, щоб завантажити останній перевірений пакет для вашої версії NVDA."

#. Translators: Title of the dialog shown when dependency libraries are missing.
#: addon\globalPlugins\NativeSpeechGeneration\lib_updater.py:244
msgid "Missing Dependencies"
msgstr "Відсутні залежності"

#. Translators: Progress message shown while verified libraries are being extracted.
#: addon\globalPlugins\NativeSpeechGeneration\lib_updater.py:289
msgid "Extracting libraries..."
msgstr "Видобування бібліотек..."

#. Translators: Progress message shown while replacing the dependency library folder.
#: addon\globalPlugins\NativeSpeechGeneration\lib_updater.py:296
msgid "Installing libraries..."
msgstr "Встановлення бібліотек..."

#. Translators: Progress message shown after library extraction and installation.
#: addon\globalPlugins\NativeSpeechGeneration\lib_updater.py:304
msgid "Library installation complete."
msgstr "Встановлення бібліотеки завершено."

#. Translators: Progress message shown before dependency download begins.
#: addon\globalPlugins\NativeSpeechGeneration\lib_updater.py:325
msgid "Downloading libraries..."
msgstr "Завантаження бібліотек..."

#. Translators: Progress message shown while dependency download is in progress.
#: addon\globalPlugins\NativeSpeechGeneration\lib_updater.py:342
msgid "Downloading..."
msgstr "Завантаження..."

#. Translators: Progress message shown while checking the downloaded dependency package.
#: addon\globalPlugins\NativeSpeechGeneration\lib_updater.py:348
msgid "Verifying libraries..."
msgstr "Перевірка бібліотек..."

#. Translators: Error shown when a downloaded dependency archive contains an unsafe path.
#: addon\globalPlugins\NativeSpeechGeneration\lib_updater.py:400
#, python-brace-format
msgid "The library archive contains an unsafe path: {path}"
msgstr "Архів бібліотеки містить небезпечний шлях: {path}"

#. Translators: Error shown when a downloaded dependency archive would extract outside the target folder.
#: addon\globalPlugins\NativeSpeechGeneration\lib_updater.py:406
#, python-brace-format
msgid ""
"The library archive contains a path outside the installation directory: "
"{path}"
msgstr "Архів бібліотеки містить шлях поза каталогом встановлення: {path}"

#. Translators: Error shown when a downloaded dependency package fails checksum verification.
#: addon\globalPlugins\NativeSpeechGeneration\lib_updater.py:424
#, python-brace-format
msgid "Library checksum mismatch. Expected {expected}, got {actual}."
msgstr ""
"Невідповідність контрольної суми бібліотеки. Очікуване значення {expected}, "
"отримано {actual}."

#. Translators: Error shown when a GitHub release lacks the dependency asset needed for this NVDA version.
#: addon\globalPlugins\NativeSpeechGeneration\lib_updater.py:468
#, python-brace-format
msgid "The latest library release does not contain {assetName}."
msgstr "Останній випуск бібліотеки не містить {assetName}."

#. Translators: Error shown when a dependency release lacks checksum metadata.
#: addon\globalPlugins\NativeSpeechGeneration\lib_updater.py:491
#, python-brace-format
msgid "The latest library release does not include a checksum for {assetName}."
msgstr "В останній версії бібліотеки відсутня контрольна сума для {assetName}."

#. Translators: Title of the dialog for the "Talk With AI" feature (REAL-TIME conversation).
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:64
msgid "Talk With AI"
msgstr "Розмова з ШІ"

#. Translators: Choice label for the lowest reasoning setting in Talk With AI.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:99
msgid "No Thinking"
msgstr "Без роздумів"

#. Translators: Choice label for low reasoning depth in Talk With AI.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:101
msgid "Low"
msgstr "Низький"

#. Translators: Choice label for medium reasoning depth in Talk With AI.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:103
msgid "Medium"
msgstr "Середній"

#. Translators: Choice label for high reasoning depth in Talk With AI.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:105
msgid "High"
msgstr "Високий"

#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:115
msgid ""
"PyAudio is not available. This feature requires a working PyAudio "
"installation."
msgstr ""
"PyAudio недоступний. Для цієї функції потрібна працездатна інсталяція "
"PyAudio."

#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:124
msgid "Google GenAI is not available."
msgstr "Google GenAI недоступний."

#. Translators: Group label for connection status in the Talk With AI dialog.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:170
msgid "Status"
msgstr "Статус"

#. Translators: Status label. {status} is replaced with the current Talk With AI status.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:175
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:282
#, python-brace-format
msgid "Status: {status}"
msgstr "Статус: {status}"

#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:175
msgid "Ready to Connect"
msgstr "Готовий до підключення"

#. Translators: Group label for Talk With AI controls.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:181
msgid "Controls"
msgstr "Керування"

#. Translators: Button to start the voice conversation.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:186
msgid "Start Conversation"
msgstr "Розпочати розмову"

#. Translators: Button to stop the voice conversation.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:189
msgid "Stop Conversation"
msgstr "Зупинити розмову"

#. Translators: Toggle button label indicating microphone is ON.
#. Translators: Toggle button label indicating microphone state.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:198
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:301
msgid "Microphone: ON"
msgstr "Мікрофон: УВІМК"

#. Translators: Label for selecting the microphone input device.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:207
msgid "Microphone:"
msgstr "Мікрофон:"

#. Translators: Label for selecting the speaker output device.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:218
msgid "Speaker:"
msgstr "Голос:"

#. Translators: Checkbox to enable grounding with Google Search in Talk With AI.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:230
msgid "Grounding with Google Search"
msgstr "Перевірка за допомогою пошуку Google"

#. Translators: Label for choosing the reasoning depth in Talk With AI.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:236
msgid "Thinking level:"
msgstr "Рівень міркування:"

#. Translators: Label for the Talk With AI playback volume slider.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:245
msgid "Volume:"
msgstr "Гучність:"

#. Translators: Informational label. {voiceName} is replaced with the selected Gemini voice.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:257
#, python-brace-format
msgid "Voice: {voiceName}"
msgstr "Голос: {voiceName}"

#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:301
msgid "Microphone: OFF"
msgstr "Мікрофон: ВИМК"

#. Translators: Dependency error detail. {baseMessage} is the main error and {errorDetail} is the import exception.
#. Translators: Error details appended to a dependency import failure.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:321
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:525
#, python-brace-format
msgid ""
"{baseMessage}\n"
"\n"
"Import detail: {errorDetail}"
msgstr ""
"{baseMessage}\n"
"\n"
"Подробиці імпорту: {errorDetail}"

#. Translators: Dependency compatibility error for Talk With AI.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:409
#, python-brace-format
msgid ""
"Installed google-genai library ({version}) does not support the Gemini 3.1 "
"Live API features required by Talk With AI. Missing: {missing}. Please "
"update the add-on libraries."
msgstr ""
"Установлена бібліотека google-genai ({version}) не підтримує можливості "
"Gemini 3.1 Live API, потрібні для функції «Розмова з ШІ». Відсутні: "
"{missing}. Будь ласка, оновіть бібліотеки додатка."

#. Translators: Dependency compatibility error for Talk With AI when no library version is known.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:416
#, python-brace-format
msgid ""
"Installed google-genai library does not support the Gemini 3.1 Live API "
"features required by Talk With AI. Missing: {missing}. Please update the add-"
"on libraries."
msgstr ""
"Установлена бібліотека google-genai не підтримує можливості Gemini 3.1 Live "
"API, потрібні для функції «Розмова з ШІ». Відсутні: {missing}. Будь ласка, "
"оновіть бібліотеки додатка."

#. Translators: Status shown while Talk With AI is connecting.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:458
msgid "Connecting..."
msgstr "Підключення..."

#. Translators: Status shown while Talk With AI is disconnecting.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:467
msgid "Disconnecting..."
msgstr "Відключення..."

#. Translators: Error shown when google-genai type helpers are missing.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:626
msgid "Google GenAI types are not available."
msgstr "Типи Google GenAI недоступні."

#. Translators: Error shown when Live API configuration cannot be built.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:650
msgid ""
"Failed to prepare the Gemini Live configuration. Please update the add-on "
"libraries."
msgstr ""
"Не вдалося підготувати конфігурацію Gemini Live. Будь ласка, оновіть "
"бібліотеки додатка."

#. Translators: Dependency compatibility error for Talk With AI.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:661
#, python-brace-format
msgid ""
"The installed google-genai library ({version}) is too old for Gemini 3.1 "
"Live sessions. Missing session method: {methodName}. Please update the add-"
"on libraries."
msgstr ""
"Установлена бібліотека google-genai ({version}) застаріла для Live-сеансів "
"Gemini 3.1. Відсутній метод сеансу: {methodName}. Будь ласка, оновіть "
"бібліотеки додатка."

#. Translators: Dependency compatibility error for Talk With AI when no library version is known.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:670
#, python-brace-format
msgid ""
"The installed google-genai library is too old for Gemini 3.1 Live sessions. "
"Missing session method: {methodName}. Please update the add-on libraries."
msgstr ""
"Установлена бібліотека google-genai застаріла для Live-сеансів Gemini 3.1. "
"Відсутній метод сеансу: {methodName}. Будь ласка, оновіть бібліотеки додатка."

#. Translators: Status shown when Talk With AI connects successfully.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:822
msgid "Connected"
msgstr "З'єднано"

#. Translators: Status shown while Talk With AI waits before reconnecting.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:870
#, python-brace-format
msgid "Connection lost. Retrying in {seconds:.1f}s"
msgstr "З'єднання втрачено. Повторна спроба через {seconds:.1f}s"

#. Translators: Status shown when Talk With AI is ready for a new session.
#: addon\globalPlugins\NativeSpeechGeneration\talkWithAI.py:925
msgid "Ready"
msgstr "Готово"

#. Translators: Name of the add-on in the NVDA Tools menu.
#: addon\globalPlugins\NativeSpeechGeneration\__init__.py:87
msgid "&Native Speech Generation"
msgstr "&Генерація природного мовлення"

#. Translators: Tooltip or description for the Native Speech Generation Tools menu item.
#: addon\globalPlugins\NativeSpeechGeneration\__init__.py:89
msgid "Generate speech using Gemini TTS"
msgstr "Генерувати мовлення за допомогою Gemini TTS"

#. Translators: Input gesture description for opening the Native Speech Generation dialog.
#: addon\globalPlugins\NativeSpeechGeneration\__init__.py:95
msgid "Open the Native Speech Generation dialog"
msgstr "Відкриває діалог генерації природного мовлення"

#. Translators: Input gestures category name for Native Speech Generation.
#. Translators: Title of the settings panel in NVDA preferences.
#. Translators: Summary for this add-on shown in NVDA's Add-ons Store and Add-ons Manager.
#: addon\globalPlugins\NativeSpeechGeneration\__init__.py:97
#: addon\globalPlugins\NativeSpeechGeneration\interface\settings.py:25
#: buildVars.py:12
msgid "Native Speech Generation"
msgstr "Генерація природного мовлення"

#. Translators: Warning shown when the user tries to open the add-on dialog twice.
#: addon\globalPlugins\NativeSpeechGeneration\__init__.py:115
msgid ""
"The Native Speech Generation add-on is already open. Please close the dialog "
"before opening it again."
msgstr ""
"Додаток Генерація природного мовлення вже відкрито. Закрийте діалог додатка, "
"перш ніж відкривати його знову."

#. Translators: Title of warning dialog when the user tries to open the add-on twice.
#: addon\globalPlugins\NativeSpeechGeneration\__init__.py:118
msgid "Add-on Already Running"
msgstr "Додаток вже запущено"

#. Translators: Error shown when the main add-on dialog cannot be opened.
#: addon\globalPlugins\NativeSpeechGeneration\__init__.py:133
#, python-brace-format
msgid "Failed to open Native Speech Generation dialog: {error}"
msgstr "Не вдалося відкрити діалог«Генерація природного мовлення»: {error}"

#. Translators: Message shown when dependency installation is still pending.
#: addon\globalPlugins\NativeSpeechGeneration\__init__.py:143
msgid ""
"Native Speech Generation is installing dependencies. Please restart NVDA for "
"the changes to take effect."
msgstr ""
"Генерація природного мовлення встановлює залежності. Перезапустіть NVDA, щоб "
"зміни набули чинності."

#. Translators: Title of the information dialog recommending an NVDA restart.
#: addon\globalPlugins\NativeSpeechGeneration\__init__.py:147
msgid "Restart Required"
msgstr "Потрібен перезапуск"

#. Translators: Message shown when generated audio was saved but could not be opened automatically.
#: addon\globalPlugins\NativeSpeechGeneration\core\audio_utils.py:117
#, python-brace-format
msgid "Audio generated, but failed to play automatically: {error}"
msgstr ""
"Аудіофайл створено, але не вдалося відтворити його автоматично: {error}"

#. Translators: Title of an informational message dialog.
#: addon\globalPlugins\NativeSpeechGeneration\core\audio_utils.py:119
msgid "Info"
msgstr "Інформація"

#. Translators: The title of the main dialog window for generating speech.
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:63
msgid "Native Speech Generation (Gemini TTS)"
msgstr "Генерація природного мовлення (Gemini TTS)"

#. Translators: Model option for the newest Gemini Flash text-to-speech preview.
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:87
msgid "Flash 3.1 Preview"
msgstr "Flash 3.1 Preview"

#. Translators: Description for the Gemini Flash 3.1 Preview model.
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:89
msgid "Powerful, low-latency speech generation, very good for short audio."
msgstr ""
"Потужна генерація мовлення з низькою затримкою, дуже хороша для короткого "
"аудіо."

#. Translators: Model option for the older Gemini Flash text-to-speech preview.
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:94
msgid "Flash 2.5"
msgstr "Flash 2.5"

#. Translators: Description for the Gemini Flash 2.5 model.
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:96
msgid "Standard quality, responsive speech generation."
msgstr "Стандартна якість, генерація адаптивного мовлення."

#. Translators: Model option for the Gemini Pro text-to-speech preview.
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:101
msgid "Pro 2.5 (High Quality)"
msgstr "Pro 2.5 (висока якість)"

#. Translators: Description for the Gemini Pro 2.5 model.
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:103
msgid "Premium speech generation with more realistic voices."
msgstr "Преміальна генерація мовлення з більш реалістичними голосами."

#. Translators: Label for the text area where user inputs text to be converted to speech.
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:111
msgid "&Type text to convert here:"
msgstr "&Введіть тут текст для перетворення:"

#. Translators: Label for optional instructions on how the speech should be spoken (e.g. "Happy", "Sad").
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:117
msgid "&Style instructions (optional):"
msgstr "&Інструкції щодо стилю (за бажанням):"

#. Translators: Label for selecting the AI model to use for generation.
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:125
msgid "Select &Model:"
msgstr "Виберіть модель:"

#. Translators: Radio button to select single speaker mode.
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:137
msgid "Single-speaker"
msgstr "Одномовний"

#. Translators: Radio button to select multi-speaker mode.
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:139
msgid "Multi-speaker (2)"
msgstr "Багатомовний (2)"

#. Translators: Checkbox to show advanced settings like Temperature.
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:152
msgid "Advanced Settings (&Temperature)"
msgstr "Розширені налаштування (&тембр)"

#. Translators: Label for the temperature slider which controls creativity of the AI.
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:162
msgid "Temperature:"
msgstr "Тембр:"

#. Translators: Button to start generating the speech audio.
#. Translators: Button label restored after speech generation finishes.
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:188
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:673
msgid "&Generate Speech"
msgstr "&Генерувати мовлення"

#. Translators: Button to play the generated audio.
#: addon\globalPlugins\NativeSpeechGeneration\interface\generation_dialog.py:193
msgid "&Play"
msgstr "&Грати"

#. Translators: Button to save the generated audio to a file.
